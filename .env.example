# Telegram API credentials (my.telegram.org)
API_ID=
API_HASH=

# source channels/bots to listen (comma-separated usernames)
SOURCE_CHANNELS=

# group C id where posts are published (integer id)
GROUP_C=

# target groups/chats for approved posts (comma-separated ids or usernames)
GROUP_D_TARGETS=

# custom stats file name (optional, default stats.json)
STATS_FILE_NAME=

# AI mode: news usefulness check via OpenAI-compatible API (DanyAPI)
# 1 = enabled by default, 0 = disabled until ".ai" command
AI_MODE=0
AI_API_BASE=http://127.0.0.1:8000/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=
AI_CHECK_DELAY=5
AI_TIMEOUT=60

# AI fix (.fix): rewrite post text in proper Ukrainian
# empty values fall back to AI_API_BASE / AI_MODEL / AI_API_KEY / AI_TIMEOUT
#AI_FIX_API_BASE=
#AI_FIX_MODEL=
#AI_FIX_API_KEY=
#AI_FIX_TIMEOUT=60
